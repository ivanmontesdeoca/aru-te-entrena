# Firebase Web SDK (public configuration, used by the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only; reuses ADC when available)
FIREBASE_ADMIN_PROJECT_ID=
# Optional legacy fallback when GOOGLE_APPLICATION_CREDENTIALS is not defined
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheets service account and spreadsheet (server only)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Preferred locally: path to the complete service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\to\\service-account.example.json"
# Optional fallback when GOOGLE_APPLICATION_CREDENTIALS is not defined
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
