# Firebase Web SDK (public configuration, used by the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only; reuses ADC when available)
FIREBASE_ADMIN_PROJECT_ID=

# Canonical public origin, required in production for strict request validation
APP_ORIGIN=https://app.example.com

# Google Sheets service account and spreadsheet (server only)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Preferred locally: path to the complete service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.example.json"
# Production/serverless fallback; also reused by Firebase Admin
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI API (server only)
OPENAI_API_KEY=
